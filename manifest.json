{
  "manifest_version": 3,
  "name": "Tab Timer",
  "version": "1.1.0",
  "description": "Set per-tab timers with actions like alert, close, reload, mute, or focus.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "tabs",
    "tabGroups",
    "offscreen",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Open Tab Timer popup"
    },
    "quick-timer": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Start quick timer (default preset) on current tab"
    }
  }
}
